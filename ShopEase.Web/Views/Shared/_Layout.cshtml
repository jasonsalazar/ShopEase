<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopEase</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShopEase.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    <span class="text-primary">Shop</span>Ease
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#storeNavbar"
                        aria-controls="storeNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="storeNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Store" asp-action="Index">
                                Shop
                            </a>
                        </li>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MyOrders" asp-action="Index">
                                    My Orders
                                </a>
                            </li>

                            <li class="nav-item">
                                <span class="nav-link">
                                    Hello, @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">
                                        Sign out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    Sign in
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                    <form asp-controller="Store" asp-action="Index" method="get"
                          class="d-flex gap-2 my-3 my-lg-0 me-lg-3" role="search">
                        <input type="search" name="search" class="form-control" placeholder="Search products..."
                               aria-label="Search products" />

                        <button type="submit" class="btn btn-outline-dark">
                            Search
                        </button>
                    </form>

                    @await Component.InvokeAsync("CartSummary")
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="store-footer mt-5 border-top">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none fs-5 fw-bold text-dark">
                        ShopEase
                    </a>

                    <p class="text-secondary mt-2 mb-0">
                        Discover products for your everyday needs.
                    </p>
                </div>

                <div class="col-md-3">
                    <h2 class="h6 fw-bold">Explore</h2>

                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Index" class="store-footer-link">
                                Home
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Store" asp-action="Index" class="store-footer-link">
                                All Products
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h2 class="h6 fw-bold">Your Shopping</h2>

                    <a asp-controller="Store" asp-action="Cart" class="store-footer-link">
                        Shopping Cart
                    </a>
                </div>
            </div>

            <hr />

            <p class="small text-secondary mb-0">
                &copy; @DateTime.Now.Year ShopEase.
                All rights reserved.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
