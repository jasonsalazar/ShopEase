@model ShopEase.Application.Features.Products.ProductPageDto

@{
    ViewData["Title"] = "Products";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Products</h1>
            <p class="text-muted mb-0">Manage your store inventory.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Product
        </a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-6">
            <input name="search" value="@Model.Search" class="form-control" placeholder="Search products..." />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" type="submit">
                Search
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Stock</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@product.Name</div>
                                <small class="text-muted">
                                    #@product.Id
                                </small>
                            </td>
                            <td>@product.CategoryName</td>
                            <td class="text-end">
                                @product.Price.ToString("C")
                            </td>
                            <td class="text-end">
                                @if (product.StockQuantity == 0)
                                {
                                    <span class="badge bg-danger">Out of stock</span>
                                }
                                else
                                {
                                    @product.StockQuantity
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">
                                    View
                                </a>
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this product?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                No products found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Product pages">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">Previous</a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-route-page="@i" asp-route-search="@Model.Search">@i</a>
                    </li>
                }

                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>