@model ShopEase.Domain.Entities.Order

@{
    ViewData["Title"] = "My Order Details";
}

<div class="container py-5">
    <div class="d-flex justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h2">Order details</h1>
            <p class="text-muted mb-0">@Model.OrderNumber</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to my orders
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <p>
                <strong>Status:</strong> @Model.Status
            </p>
            <p>
                <strong>Order date:</strong>
                @Model.CreatedAt.ToLocalTime().ToString("f")
            </p>
            <p class="mb-0">
                <strong>Shipping address:</strong><br />
                @Model.ShippingAddress<br />
                @Model.City, @Model.PostalCode
            </p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-end">Unit price</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td class="text-end">@item.UnitPrice.ToString("C")</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end">@item.Subtotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th class="text-end">@Model.Total.ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
